{
  "info": {
    "_postman_id": "aa43e6f4-4d61-4d9d-b420-24fc0478ed95",
    "name": "VMC Fleet Driver API",
    "description": "Mobile API requests for VMC vehicle drivers. Set base_url to the running Laravel API (for example http://127.0.0.1:8000), set driver_email and driver_password, then run Login first. The login request stores the Sanctum token for the other requests. Each vehicle assignment has one explicit driver; fleet APIs and GPS/status updates are limited to that assigned driver.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "driver_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "driver_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "assignment_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "job_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehicle_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "device_latitude",
      "value": "",
      "type": "string"
    },
    {
      "key": "device_longitude",
      "value": "",
      "type": "string"
    },
    {
      "key": "notification_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', body.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driver_email}}\",\n  \"password\": \"{{driver_password}}\",\n  \"device_name\": \"VMC Driver App\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates an active user and stores the returned Sanctum bearer token in access_token. Vehicle drivers may optionally include the current device latitude and longitude (plus speed_kph and recorded_at) to record a login GPS point; the response includes data.vehicle.location."
          },
          "response": []
        },
        {
          "name": "Login with Device GPS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GPS login succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', body.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driver_email}}\",\n  \"password\": \"{{driver_password}}\",\n  \"device_name\": \"VMC Driver App\",\n  \"latitude\": \"{{device_latitude}}\",\n  \"longitude\": \"{{device_longitude}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Set device_latitude and device_longitude to the current device fix before sending. The response includes the linked vehicle location under data.vehicle.location."
          },
          "response": []
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Returns the authenticated user's profile, roles, permissions, and station access."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the current Sanctum token. Run Login again before sending other authenticated requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Fleet",
      "item": [
        {
          "name": "Driver Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fleet/dashboard",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fleet",
                "dashboard"
              ]
            },
            "description": "Returns the authenticated driver's active assignments for the dashboard. Each assignment includes live vehicle location as navigation.origin and incident coordinates/address as navigation.destination. Refresh this endpoint to update the live position."
          },
          "response": []
        },
        {
          "name": "List My Active Assignments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Assignments request succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const records = pm.response.json().data || [];",
                  "    if (records.length > 0) {",
                  "        pm.collectionVariables.set('assignment_id', records[0].id);",
                  "        if (records[0].job && records[0].job.id) pm.collectionVariables.set('job_id', records[0].job.id);",
                  "        if (records[0].vehicle && records[0].vehicle.id) pm.collectionVariables.set('vehicle_id', records[0].vehicle.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fleet/assignments?per_page=15&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fleet",
                "assignments"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Returns active assignments explicitly assigned to the signed-in driver, including data[].driver and the vehicle's latest location and GPS recorded_at timestamp at data[].vehicle.location. Refresh this endpoint after the driver submits a GPS update to get the newest coordinates. The test script stores the first assignment, job, and vehicle IDs when present."
          },
          "response": []
        },
        {
          "name": "List My Assigned Vehicles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Vehicles request succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const records = pm.response.json().data || [];",
                  "    if (records.length > 0) pm.collectionVariables.set('vehicle_id', records[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fleet/vehicles?per_page=15&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fleet",
                "vehicles"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Returns only vehicles on the driver's active assignments."
          },
          "response": []
        },
        {
          "name": "List Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Notifications request succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const records = pm.response.json().data || [];",
                  "    if (records.length > 0) pm.collectionVariables.set('notification_id', records[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fleet/notifications?unread_only=1&per_page=15&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fleet",
                "notifications"
              ],
              "query": [
                {
                  "key": "unread_only",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Returns the authenticated driver's notification inbox. Set unread_only to 0 to include read notifications."
          },
          "response": []
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fleet/notifications/{{notification_id}}/read",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fleet",
                "notifications",
                "{{notification_id}}",
                "read"
              ]
            },
            "description": "Marks a notification belonging to the authenticated driver as read. Send List Notifications first to populate notification_id."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Driver Assignment Workflow",
      "description": "Driver actions backed by VMC assignment lifecycle history. assignment_id may be the numeric assignment ID stored by List My Active Assignments or the public incident job_id. Coordinates are optional and should be populated with the device's current GPS fix.",
      "item": [
        {
          "name": "Get Active Driver Assignment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const record = pm.response.json().data;",
                  "    if (record && record.assignmentId) {",
                  "        pm.collectionVariables.set('assignment_id', record.assignmentId);",
                  "    } else {",
                  "        pm.collectionVariables.unset('assignment_id');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/v1/driver/assignments/active",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "assignments", "active"]
            },
            "description": "Returns the latest active assignment for the authenticated vehicle driver, or data: null when none is active."
          },
          "response": []
        },
        {
          "name": "Attend / Start Assignment",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{}", "options": {"raw": {"language": "json"}}},
            "url": {
              "raw": "{{base_url}}/api/v1/driver/assignments/{{assignment_id}}/attend",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "assignments", "{{assignment_id}}", "attend"]
            },
            "description": "Transitions ASSIGNED to EN_ROUTE. GPS fields are optional; add driverLatitude and driverLongitude from the device's current GPS fix when available."
          },
          "response": []
        },
        {
          "name": "Decline Assignment",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"reason\": \"Vehicle unavailable\",\n  \"additionalNotes\": \"Provide additional context\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {
              "raw": "{{base_url}}/api/v1/driver/assignments/{{assignment_id}}/decline",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "assignments", "{{assignment_id}}", "decline"]
            },
            "description": "Declines only a pending assignment, releases its driver/vehicle allocation, and returns the incident to RECEIVED when no other assignment remains active."
          },
          "response": []
        },
        {
          "name": "Escalate Assignment",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"reason\": \"Additional equipment required\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {
              "raw": "{{base_url}}/api/v1/driver/assignments/{{assignment_id}}/escalate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "assignments", "{{assignment_id}}", "escalate"]
            },
            "description": "Appends an assignment-scoped remark and sends a database notification to active CONTROL_ROOM_ADMIN users."
          },
          "response": []
        },
        {
          "name": "Request Need Help",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"helpType\": \"ROUTE_PROBLEM\",\n  \"comments\": \"Request traffic assistance\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {
              "raw": "{{base_url}}/api/v1/driver/assignments/{{assignment_id}}/need-help",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "assignments", "{{assignment_id}}", "need-help"]
            },
            "description": "Accepts helpType (AMBULANCE, WATER_TANKER, VEHICLE_BREAKDOWN, ACCIDENT, MEDICAL_EMERGENCY, FIRE_EQUIPMENT_PROBLEM, ROUTE_PROBLEM, OTHER) and optional comments. Also accepts the legacy reason field. Stores the request and notifies active CONTROL_ROOM_ADMIN users with the incident, driver, vehicle, station, and team details; the dashboard displays recent requests."
          },
          "response": [
            {
              "name": "200 Success - Help Request Sent",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"helpType\": \"ROUTE_PROBLEM\",\n  \"comments\": \"Request traffic assistance\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/driver/assignments/{{assignment_id}}/need-help",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "driver",
                    "assignments",
                    "{{assignment_id}}",
                    "need-help"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Urgent help request sent to control room\",\n  \"data\": {\n    \"id\": \"VMC-INCIDENT-0001\",\n    \"assignmentId\": 8,\n    \"emergencyType\": \"ROAD_ACCIDENT\",\n    \"title\": \"Central Road\",\n    \"location\": \"Central Road, Vadodara\",\n    \"startingLocation\": \"Central Fire Station\",\n    \"destinationLocation\": \"Central Road, Vadodara\",\n    \"route\": null,\n    \"distanceKm\": null,\n    \"callerName\": \"Sample Caller\",\n    \"callerMobile\": \"9876543210\",\n    \"receivedAt\": \"2026-11-12T10:00:00+05:30\",\n    \"startedAt\": null,\n    \"reachedAt\": null,\n    \"completedAt\": null,\n    \"status\": \"ASSIGNED\",\n    \"declineReason\": null,\n    \"escalationReason\": null,\n    \"needHelpReason\": \"ROUTE PROBLEM\",\n    \"helpType\": \"ROUTE_PROBLEM\",\n    \"helpComments\": \"Request traffic assistance\",\n    \"selectedIssues\": null,\n    \"issueRemarks\": null,\n    \"closeReason\": null,\n    \"closedAt\": null,\n    \"actionHistory\": [\n      {\n        \"action\": \"need_help\",\n        \"details\": {\n          \"reason\": \"ROUTE PROBLEM\",\n          \"help_type\": \"ROUTE_PROBLEM\",\n          \"comments\": \"Request traffic assistance\"\n        },\n        \"occurredAt\": \"2026-11-12T10:15:00+05:30\"\n      }\n    ],\n    \"currentSpeedKmh\": null,\n    \"expectedReachTime\": null,\n    \"startLatitude\": null,\n    \"startLongitude\": null,\n    \"destLatitude\": 22.3072,\n    \"destLongitude\": 73.1812,\n    \"latitude\": null,\n    \"longitude\": null,\n    \"controlRoomRecipients\": 1\n  }\n}"
            }
          ]
        },
        {
          "name": "Mark Reached Location",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{}", "options": {"raw": {"language": "json"}}},
            "url": {
              "raw": "{{base_url}}/api/v1/driver/assignments/{{assignment_id}}/reached",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "assignments", "{{assignment_id}}", "reached"]
            },
            "description": "Transitions EN_ROUTE to ARRIVED and optionally records the current device GPS using reachedLatitude, reachedLongitude, and reachedTime."
          },
          "response": []
        },
        {
          "name": "Mark Started at Incident",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{}", "options": {"raw": {"language": "json"}}},
            "url": {
              "raw": "{{base_url}}/api/v1/driver/assignments/{{assignment_id}}/started",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "assignments", "{{assignment_id}}", "started"]
            },
            "description": "Sets assignment status to STARTED at the incident. Optional reachedLatitude, reachedLongitude, and reachedTime record arrival location and time."
          },
          "response": []
        },
        {
          "name": "Mark Assignment In Progress",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{}", "options": {"raw": {"language": "json"}}},
            "url": {
              "raw": "{{base_url}}/api/v1/driver/assignments/{{assignment_id}}/in-progress",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "assignments", "{{assignment_id}}", "in-progress"]
            },
            "description": "Sets assignment status to IN_PROGRESS."
          },
          "response": []
        },
        {
          "name": "Report Route / Incident Issues",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"selectedIssues\": [\"Narrow access\", \"Route obstruction\"],\n  \"issueRemarks\": \"Add field details\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {
              "raw": "{{base_url}}/api/v1/driver/assignments/{{assignment_id}}/report-issues",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "assignments", "{{assignment_id}}", "report-issues"]
            },
            "description": "Appends the selected field issues and remarks to the incident's remark history."
          },
          "response": []
        },
        {
          "name": "Complete Assignment",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"completionNotes\": \"Response completed successfully\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {
              "raw": "{{base_url}}/api/v1/driver/assignments/{{assignment_id}}/complete",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "assignments", "{{assignment_id}}", "complete"]
            },
            "description": "Transitions an ARRIVED assignment through IN_PROGRESS and COMPLETED, then releases it under VMC lifecycle rules."
          },
          "response": []
        },
        {
          "name": "Mark Work Done",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"completionNotes\": \"Response work completed successfully\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {
              "raw": "{{base_url}}/api/v1/driver/assignments/{{assignment_id}}/work-done",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "assignments", "{{assignment_id}}", "work-done"]
            },
            "description": "Sets assignment status to WORK_DONE and releases its allocation. Optional completion notes, timestamp, and device GPS are supported."
          },
          "response": []
        },
        {
          "name": "Close Assignment",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"closeReason\": \"Duty ended\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {
              "raw": "{{base_url}}/api/v1/driver/assignments/{{assignment_id}}/close",
